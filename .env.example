# Copy to .env.local and fill in. Never put secrets here: every REACT_APP_* value ships in the public bundle.
REACT_APP_STREAM_URL=<LAMBDA FUNCTION URL>
REACT_APP_EMAIL_URL=<LAMBDA FUNCTION URL>
REACT_APP_GREETING_PROMPT=<INSERT PROMPT>
REACT_APP_NO_TOKENS_PROMPT=<INSERT PROMPT>
REACT_APP_RESUME_LINK=<INSERT LINK>
REACT_APP_CONTACT_EMAIL=<INSERT EMAIL>
REACT_APP_GITHUB_LINK=<INSERT LINK>
REACT_APP_LINKEDIN_LINK=<INSERT LINK>
REACT_APP_MAX_QUESTION_TOKENS=5
REACT_APP_PROMO_HASHTAG=<INSERT HASHTAG>
